{
  "id": "opsapi-prod-default",
  "name": "opsapi-prod-default",
  "profile_id": "prod",
  "priority": 1,
  "rules_tags": [
    "opsapi",
    "workstation",
    "prod"
  ],
  "match": {
    "rules": {
      "path": "/",
      "path_key": "starts_with"
    },
    "response": {
      "code": 305,
      "redirect_uri": "193.237.176.232:8888",
      "strip_path": false,
      "backends": [
        {
          "address": "193.237.176.232:8888",
          "weight": 100,
          "label": "193.237.176.232:8888 k3s ingress entry (same backend as the working beacon/*.workstation.co.uk hosts); routes by Host header"
        }
      ],
      "routing": {
        "mode": "least_conn"
      }
    }
  },
  "servers": [
    "host:int-opsapi.workstation.co.uk",
    "host:test-opsapi.workstation.co.uk",
    "host:acc-opsapi.workstation.co.uk",
    "host:int-opsapi-ui.workstation.co.uk"
  ]
}