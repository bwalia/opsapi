{
  "name": "@opsapi/client",
  "version": "1.3.0",
  "description": "Typed client for the OpsAPI REST API: auth (incl. 2FA), workspaces, typed requests for every endpoint, pagination, retries, webhook verification, billing entitlements and licences.",
  "license": "MIT",
  "homepage": "https://github.com/bwalia/opsapi/tree/main/sdk/typescript#readme",
  "bugs": { "url": "https://github.com/bwalia/opsapi/issues" },
  "keywords": ["opsapi", "api-client", "openapi", "typescript", "webhooks", "entitlements", "licensing", "property"],
  "repository": { "type": "git", "url": "https://github.com/bwalia/opsapi.git", "directory": "sdk/typescript" },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./billing": {
      "import": { "types": "./dist/billing.d.ts", "default": "./dist/billing.js" },
      "require": { "types": "./dist/billing.d.cts", "default": "./dist/billing.cjs" }
    },
    "./property-deals": {
      "import": { "types": "./dist/property-deals.d.ts", "default": "./dist/property-deals.js" },
      "require": { "types": "./dist/property-deals.d.cts", "default": "./dist/property-deals.cjs" }
    }
  },
  "files": ["dist", "README.md", "CHANGELOG.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "generate": "node scripts/generate.mjs --core ${OPSAPI_OPENAPI_URL:-http://127.0.0.1:4010/openapi.json} -o src/generated/opsapi.ts",
    "generate:property-deals": "node scripts/generate.mjs --plugin property_deals ${OPSAPI_OPENAPI_URL:-http://127.0.0.1:4010/openapi.json} -o src/generated/property-deals.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "publishConfig": { "access": "public", "provenance": true },
  "dependencies": {
    "openapi-fetch": "^0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "openapi-typescript": "^7.13.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
