{
  "name": "@opsapi/mcp",
  "version": "0.3.0",
  "description": "MCP server for OpsAPI: kanban tasks (list, create, update, move, search, log time, attach PRs) and website content (posts, pages, categories, images, website updates), acting as you via a personal API key. stdio and Streamable HTTP.",
  "type": "module",
  "bin": {
    "opsapi-mcp": "dist/index.js",
    "opsapi-kanban-mcp": "dist/index.js",
    "opsapi-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "README.md",
    "GETTING-STARTED.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsc && node dist/index.js",
    "test": "tsc && node --test test/*.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
