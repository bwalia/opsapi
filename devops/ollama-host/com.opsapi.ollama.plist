<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- OpsAPI's own Ollama: a separate `ollama serve` on :11439 with its own queue and scheduler, so other
     products' requests on the shared :11434 can't hold up or wedge OpsAPI's assistant. Same model files
     (~/.ollama/models), so nothing is downloaded twice. Installed by install.sh. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.opsapi.ollama</string>
  <key>ProgramArguments</key><array><string>/opt/homebrew/opt/ollama/bin/ollama</string><string>serve</string></array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>OLLAMA_HOST</key><string>0.0.0.0:11439</string>
    <key>OLLAMA_NUM_PARALLEL</key><string>4</string>
    <key>OLLAMA_MAX_LOADED_MODELS</key><string>3</string>
    <key>OLLAMA_MAX_QUEUE</key><string>64</string>
    <key>OLLAMA_CONTEXT_LENGTH</key><string>16384</string>
    <key>OLLAMA_KEEP_ALIVE</key><string>30m</string>
    <key>OLLAMA_KV_CACHE_TYPE</key><string>q8_0</string>
    <key>OLLAMA_FLASH_ATTENTION</key><string>1</string>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/ollama/opsapi.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/ollama/opsapi.err.log</string>
</dict>
</plist>
