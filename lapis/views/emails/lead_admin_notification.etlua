<% if headline and headline ~= "" then %>
<h2><%= headline %><% if namespace_name and namespace_name ~= "" then %> — <%= namespace_name %><% end %></h2>
<% else %>
<h2>You've got a new lead<% if namespace_name and namespace_name ~= "" then %> — <%= namespace_name %><% end %></h2>
<% end %>

<% if intro and intro ~= "" then %>
<p><%= intro %></p>
<% else %>
<p>A new enquiry has just come in. The details are below — log in to your dashboard and open <strong>Leads</strong> to follow up.</p>
<% end %>

<div class="info-box">
  <p><strong>Name:</strong> <%= first_name %><% if last_name and last_name ~= "" then %> <%= last_name %><% end %></p>
  <% if company_name and company_name ~= "" then %><p><strong>Company:</strong> <%= company_name %></p><% end %>
  <% if job_title and job_title ~= "" then %><p><strong>Job title:</strong> <%= job_title %></p><% end %>
  <% if email and email ~= "" then %><p><strong>Email:</strong> <%= email %></p><% end %>
  <% if phone and phone ~= "" then %><p><strong>Phone:</strong> <%= phone %></p><% end %>
  <% if source and source ~= "" then %><p><strong>Source:</strong> <%= source %></p><% end %>
</div>

<% if ai_rating or ai_summary or ai_note then %>
<h3 style="margin-top:20px">AI analysis</h3>
<div class="info-box">
  <% if ai_rating then %><p><strong>Rating:</strong> <%= ai_rating %></p><% end %>
  <% if ai_spam then %><p><strong>Warning:</strong> this looks like spam.</p><% end %>
  <% if ai_origin then %><p><strong>Where it came from:</strong> <%= ai_origin %></p><% end %>
  <% if ai_summary then %><p><strong>Summary:</strong> <%= ai_summary %></p><% end %>
  <% if ai_next then %><p><strong>Suggested next step:</strong> <%= ai_next %></p><% end %>
  <% if ai_note then %><p><%= ai_note %></p><% end %>
</div>
<% if ai_report_url then %>
<p><a href="<%= ai_report_url %>" class="btn">Open the AI report (PDF)</a></p>
<p style="font-size:12px;color:#6b7280">The link works for <%= ai_report_days or 30 %> days. After that, download the report from the lead's page.</p>
<% end %>
<% end %>

<% if notes and notes ~= "" then %>
  <p><strong>Message:</strong></p>
  <div class="info-box" style="white-space:pre-line"><%= notes %></div>
<% end %>

<% if lead_url then %><p><a href="<%= lead_url %>">Open the lead</a></p><% end %>

<p>This is an automated notification from <%= app_name %>. You can turn these off or add a Telegram alert under Leads → Notifications.</p>
