<% if test then %>
<div style="border:2px dashed #e6007e;border-radius:8px;padding:12px 16px;margin:0 0 20px;background:#fff0f7;">
  <p style="margin:0;"><strong>TEST SEND, not sent to the customer.</strong> This is the email <%= test_customer or "the customer" %> will get. Nothing is noted on the order.</p>
</div>
<% end %>
<h2><%= headline %></h2>

<p>Hello<% if first_name and first_name ~= "" then %> <%= first_name %><% elseif customer_name and customer_name ~= "" then %> <%= customer_name %><% end %>,</p>

<% for line in ((message or "") .. "\n"):gmatch("(.-)\n") do %>
  <% if line == "" then %><br><% else %><p style="margin:0 0 8px 0;"><%= line %></p><% end %>
<% end %>

<div class="info-box" style="margin-top:20px;">
  <p><strong>Order:</strong> <%= order_number %></p>
  <% if delivery_summary and delivery_summary ~= "" then %><p><strong>Delivery:</strong> <%= delivery_summary %></p><% end %>
</div>

<% if order_link and order_link ~= "" then %>
<p style="text-align:center;margin:28px 0;">
  <a href="<%= order_link %>" class="button" style="display:inline-block;padding:12px 28px;border-radius:8px;background:#e6007e;color:#ffffff;text-decoration:none;font-weight:600;">View your order</a>
</p>
<% end %>

<p>Questions? Reply to this email<% if call_phone and call_phone ~= "" then %> or call us on <strong><%= call_phone %></strong> (Monday to Friday, 9am to 6pm)<% end %>.</p>

<p>Thanks,<br><%= signature or ("The " .. tostring(app_name or "Workstation") .. " team") %><% if signature_is_person and app_name and app_name ~= "" then %><br><%= app_name %><% end %></p>
