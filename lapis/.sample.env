# ============================================
# OpsAPI Local Development Environment
# ============================================
# Copy this file to .env: cp .sample.env .env
# Most defaults work out of the box for local development.

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_HOST=172.71.0.10
POSTGRES_PORT=5432
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpassword
POSTGRES_DB=opsapi

# ============================================
# JWT Authentication
# ============================================
# Generate a new key for production: openssl rand -base64 32
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# ============================================
# AES Encryption (AES-128-CBC)
# ============================================
# Requires 16-byte key and IV (32 hex characters each)
# Generate new keys for production: openssl rand -hex 16
OPENSSL_SECRET_KEY=8151d12b939a4670a9c3e5f7b2d4c6e8
OPENSSL_SECRET_IV=9abd41f7eec7635e1a2b3c4d5e6f7081

# ============================================
# SSL Verification
# ============================================
# Set to "true" in production with proper CA certificates
OPSAPI_SSL_VERIFY=false

# ============================================
# MinIO (S3-compatible Object Storage)
# ============================================
MINIO_ENDPOINT=http://172.71.0.17:9000
MINIO_ENDPOINT_WEB_EXTERNAL=http://localhost:9900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=opsapi
MINIO_REGION=us-east-1

# ============================================
# Dashboard & API URLs
# ============================================
# Automatically updated by start.sh based on environment
NEXT_PUBLIC_API_URL=http://127.0.0.1:4020

# ============================================
# Node API (Optional)
# ============================================
NODE_API_URL=http://172.71.0.14/api

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated domain names (allows domain + all subdomains + any port)
# CORS_ALLOWED_DOMAINS=example.com,myapp.com
# Comma-separated explicit origin URLs
# CORS_ALLOWED_ORIGINS=http://myserver:8039

# Local development only: allow http(s)://localhost and 127.0.0.1 origins.
# Never set in a deployed environment (credentials are allowed cross-origin).
CORS_ALLOW_LOCALHOST=true

# ============================================
# Kafka (Optional - Event Streaming)
# ============================================
# Kafka broker addresses (comma-separated host:port pairs)
# KAFKA_BROKERS=kafka:29092

# ============================================
# Ollama AI (Optional - Bookkeeping AI Assistant + Chat AI Agent)
# ============================================
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=mistral
# Chat AI agent (the "Chat with agent" tool-calling assistant). Point at an
# Ollama endpoint whose model supports tool calling (e.g. qwen3), and set the
# gateway API key it expects (sent as the x-api-key header):
# OLLAMA_URL=https://ollama.workstation.co.uk
# OLLAMA_MODEL=qwen3.8:latest
# OLLAMA_API_KEY=your-ollama-gateway-jwt
#
# ONE model setting for every AI feature (page assistant, chat agent, tax
# classification, bookkeeping AI, statement extraction) — pick ANY provider with
# env only, no code change (lib/agent/llm.lua). Unset = Ollama via OLLAMA_* above.
# Switch provider in production by setting just these three (examples):
#   Anthropic: AI_PROVIDER=anthropic  AI_API_KEY=sk-ant-...  AI_MODEL=claude-opus-5-5
#   OpenAI:    AI_PROVIDER=openai      AI_API_KEY=sk-...       AI_MODEL=gpt-4.1
#   Gemini:    AI_PROVIDER=gemini      AI_API_KEY=...          AI_MODEL=gemini-2.5-flash
#   Any OpenAI-compatible host (OpenRouter/Groq/Together/vLLM/Azure): AI_PROVIDER=openai + AI_BASE_URL=...
# AI_PROVIDER=anthropic          # ollama | anthropic | openai | gemini  (openai = any OpenAI-compatible API)
# AI_MODEL=claude-opus-5-5       # else OLLAMA_MODEL / ANTHROPIC_MODEL / OPENAI_MODEL / GEMINI_MODEL, then built-in defaults
# AI_API_KEY=sk-ant-...          # else OLLAMA_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY / GEMINI_API_KEY
# AI_BASE_URL=                   # optional: OpenRouter, Groq, vLLM, Azure-compatible gateway, Gemini OpenAI endpoint...
# AI_VISION_PROVIDER=            # optional: model that reads statement images/PDFs
# AI_VISION_MODEL=               # e.g. minicpm-v on Ollama; Claude/gpt-4.1 can read them directly
# AI_FALLBACK_PROVIDER=ollama    # used when the main provider fails: ollama (default) | anthropic | openai | gemini | none
# AI_FALLBACK_MODEL=             # default: that provider's own model (OLLAMA_MODEL on OLLAMA_URL / OLLAMA_API_KEY)
# AI_TIMEOUT_MS=300000          # total time for one model call in background work (timers, jobs, assistant runs)
# AI_REQUEST_TIMEOUT_MS=120000  # total time for one model call while serving a request (someone is waiting)
# AI_TLS_VERIFY=false           # dev only: skip TLS certificate checks to model servers (self-signed); default verify
# AI_PLATFORM_MODELS=           # models workspaces may run on the shared platform model, comma-separated
#                               # (default: the platform's own model, e.g. OLLAMA_MODEL)
# AI_USER_DAILY_TOKEN_LIMIT=     # optional: tokens one user may use per UTC day, all AI features (unset = no limit)

# ============================================
# Forms: custom domains (Optional, docs/FORMS.md)
# ============================================
# The edge that workspaces point their form domain at (CNAME target, or an IP
# for an A record). It must route those hosts to the dashboard and get their
# certificates; ask GET /api/v2/public/form-domains/check?domain= first.
# Unset = custom domains are off.
# FORMS_DOMAIN_TARGET=forms-edge.example.com
# DOMAIN_VERIFY_RESOLVERS=1.1.1.1,8.8.8.8   # DNS servers the ownership check asks

# ============================================
# Google OAuth (Optional)
# ============================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:4020/auth/google/callback

# Property Deals — street-level geocode for Deal finder pins (Geocoding API).
# Optional: without it, pins use the postcode centre via postcodes.io.
# Dashboard Maps JS key is NEXT_PUBLIC_GOOGLE_MAPS_API_KEY (opsapi-dashboard).
# GOOGLE_MAPS_API_KEY=
# GOOGLE_MAPS_GEOCODING_API_KEY=

# ============================================
# Keycloak SSO (Optional)
# ============================================
# KEYCLOAK_AUTH_URL=https://your-keycloak/realms/opsapi/protocol/openid-connect/auth
# KEYCLOAK_TOKEN_URL=https://your-keycloak/realms/opsapi/protocol/openid-connect/token
# KEYCLOAK_USERINFO_URL=https://your-keycloak/realms/opsapi/protocol/openid-connect/userinfo
# KEYCLOAK_CLIENT_ID=opsapi
# KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:4020/auth/callback

# ============================================
# Stripe (Optional)
# ============================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Billing & Entitlements (PROJECT_CODE=billing)
# ============================================
# EC P-256 private key (PEM, "\n" escapes ok) that signs entitlement tokens and
# offline licence files. Clients verify with GET /api/v2/public/billing/jwks.json.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# BILLING_SIGNING_KEY=
# BILLING_SIGNING_KEY_ID=billing-2026-10
# Rotation: old public JWKs (JSON array) kept in the JWKS until old tokens expire.
# BILLING_PREVIOUS_PUBLIC_KEYS=[]
# Base URL of the hosted billing pages (the dashboard), used in access-link emails.
# BILLING_HOSTED_BASE_URL=https://billing.example.com
# Allow workspace SMTP servers on private addresses (dev / self-hosted only).
# OPSAPI_MAIL_ALLOW_PRIVATE=false
# Private (LAN) model servers workspaces may use for AI providers / JobShout / mail connectors, e.g.
# Ollama or LM Studio on the office network: host or host:port, comma-separated. Link-local / cloud
# metadata addresses are always refused.
# OPSAPI_AI_PRIVATE_HOSTS=ollama.office.lan:11434,lmstudio.office.lan:1234
# DEV ONLY: allow ANY private address (databases, cluster APIs...). Logged as a warning. Never in
# shared deployments (SSRF): list the hosts above instead.
OPSAPI_AI_ALLOW_PRIVATE=false
# Payments (Stripe Connect, destination charges on the platform's STRIPE_SECRET_KEY account).
# The platform's cut of every sale, in percent (0 = none).
# STRIPE_PLATFORM_FEE_PERCENT=0
# Billing payments verify Stripe's TLS certificate unless this is "false" (only for a local stripe-mock).
# The tax app's older Stripe calls verify only when it is "true".
# STRIPE_SSL_VERIFY=true
# Signing secrets of the Stripe endpoint(s) pointing at /api/v2/public/billing/stripe/webhook,
# comma-separated: one for the platform's events, one for connected accounts' events.
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...,whsec_...
# Encrypts licence keys bought through checkout until they are shown (at most 24 h).
# Generate: openssl rand -base64 32
# LICENCE_DELIVERY_KEY=
# LICENCE_DELIVERY_KEY_ID=delivery-2026-10
# Rotation: "id:base64,id:base64" — old keys stay readable until their deliveries expire.
# LICENCE_DELIVERY_PREVIOUS_KEYS=

# ============================================
# HMRC Making Tax Digital (UK tax filing)
# ============================================
# HMRC_ENVIRONMENT switches base URLs + enables TLS verification:
#   sandbox    -> https://test-api.service.hmrc.gov.uk (ssl_verify off; test users + auto-provision)
#   production -> https://api.service.hmrc.gov.uk     (ssl_verify ON; real filings)
# HMRC_ENVIRONMENT=sandbox
# Credentials from your HMRC Developer Hub application (sandbox vs production are different apps):
# HMRC_CLIENT_ID=...
# HMRC_CLIENT_SECRET=...
# OAuth callback — must EXACTLY match the redirect URI registered on your HMRC application:
# HMRC_REDIRECT_URI=https://your-domain.example/auth/hmrc/callback
# The backend's PUBLIC egress IP (HMRC anti-fraud Gov-Vendor-Public-IP / Gov-Vendor-Forwarded).
# Required in production — HMRC rejects private IPs; omit for local dev. Find via `curl ifconfig.me`.
# HMRC_SERVER_PUBLIC_IP=203.0.113.10
#
# "Let our accountant file it for you" (routes/tax-filing). Until OpsAPI is an
# HMRC-recognised filer, customers can send their approved figures to our accountant,
# who files them with HMRC-recognised software (e.g. My Tax Digital) from the
# downloadable workbook. Staff need the `tax_filing_requests` module (Tax → Filing requests).
# TAX_FILING_NOTIFY_EMAIL=filing@yourcompany.co.uk   # accountant inbox: new requests, replies, cancels
# TAX_DIRECT_FILING_ENABLED=false                    # hide direct HMRC (MTD) filing; default shown

# ============================================
# Client IP behind proxies (rate limits, lockouts, activity)
# ============================================
# X-Forwarded-For is read from the RIGHT: hops added by trusted proxies are skipped and the first
# other address is the client. Internal ranges (10/8, 172.16/12, 192.168/16, loopback, CGNAT) are
# always trusted; list any PUBLIC proxies / CDN edges in front of OpsAPI here (IPv4 CIDRs, commas).
# Unset = only internal proxies are trusted, so a public edge's own address is used, never a spoofed one.
# OPSAPI_TRUSTED_PROXIES=203.0.113.0/24,198.51.100.7/32

# Voice for the assistant (speech-to-text + text-to-speech). Our own OpenAI-compatible voice server only
# (e.g. Speaches: faster-whisper + Kokoro/Piper); audio never goes to a public cloud. Empty = voice off.
# Operator config, so it may be a LAN address (no OPSAPI_AI_* setting needed). Workspace members only,
# rate-limited per user (20 transcriptions / 30 replies a minute). PA_STT_URL, when set, wins.
VOICE_URL=
VOICE_API_KEY=
VOICE_STT_MODEL=Systran/faster-whisper-small
VOICE_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
VOICE_TTS_VOICE=bf_emma
VOICE_LANGUAGE=en

# Hiring: ATS + AI first-round interviews (PROJECT_CODE=...,ats; docs/plans/PROMPT_ATS_INTERVIEWS.md)
# ATS_INTERVIEWER_MODEL=claude-sonnet-5-5      # with ANTHROPIC_API_KEY; else the platform AI_PROVIDER runs interviews
# ATS_EVALUATOR_MODEL=claude-opus-5-5
# ATS_PUBLIC_URL=http://127.0.0.1:8039         # dashboard base for candidate links (/i/<token>); default FRONTEND_URL
# ATS_STRIPE_PRICE_ID=price_...                # recurring price that activates the module
# ATS_STRIPE_WEBHOOK_SECRET=whsec_...          # for /api/v2/public/ats/billing/webhook (default STRIPE_WEBHOOK_SECRET)
# ATS_PAST_DUE_GRACE_DAYS=7
