# ============================================
# OpsAPI Local Development Environment
# ============================================
# Copy this file to .env: cp .sample.env .env
# Most defaults work out of the box for local development.

# ============================================
# Database (PostgreSQL)
# ============================================
POSTGRES_HOST=172.71.0.10
POSTGRES_PORT=5432
POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpassword
POSTGRES_DB=opsapi

# ============================================
# JWT Authentication
# ============================================
# Generate a new key for production: openssl rand -base64 32
JWT_SECRET_KEY=dev-jwt-secret-change-in-production

# ============================================
# AES Encryption (AES-128-CBC)
# ============================================
# Requires 16-byte key and IV (32 hex characters each)
# Generate new keys for production: openssl rand -hex 16
OPENSSL_SECRET_KEY=8151d12b939a4670a9c3e5f7b2d4c6e8
OPENSSL_SECRET_IV=9abd41f7eec7635e1a2b3c4d5e6f7081

# ============================================
# SSL Verification
# ============================================
# Set to "true" in production with proper CA certificates
OPSAPI_SSL_VERIFY=false

# ============================================
# MinIO (S3-compatible Object Storage)
# ============================================
MINIO_ENDPOINT=http://172.71.0.17:9000
MINIO_ENDPOINT_WEB_EXTERNAL=http://localhost:9900
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=opsapi
MINIO_REGION=us-east-1

# ============================================
# Dashboard & API URLs
# ============================================
# Automatically updated by start.sh based on environment
NEXT_PUBLIC_API_URL=http://127.0.0.1:4020

# ============================================
# Node API (Optional)
# ============================================
NODE_API_URL=http://172.71.0.14/api

# ============================================
# CORS Configuration (Optional)
# ============================================
# Comma-separated domain names (allows domain + all subdomains + any port)
# CORS_ALLOWED_DOMAINS=example.com,myapp.com
# Comma-separated explicit origin URLs
# CORS_ALLOWED_ORIGINS=http://myserver:8039

# ============================================
# Kafka (Optional - Event Streaming)
# ============================================
# Kafka broker addresses (comma-separated host:port pairs)
# KAFKA_BROKERS=kafka:29092

# ============================================
# Ollama AI (Optional - Bookkeeping AI Assistant + Chat AI Agent)
# ============================================
# OLLAMA_URL=http://ollama:11434
# OLLAMA_MODEL=mistral
# Chat AI agent (the "Chat with agent" tool-calling assistant). Point at an
# Ollama endpoint whose model supports tool calling (e.g. qwen3), and set the
# gateway API key it expects (sent as the x-api-key header):
# OLLAMA_URL=https://ollama.workstation.co.uk
# OLLAMA_MODEL=qwen3.8:latest
# OLLAMA_API_KEY=your-ollama-gateway-jwt
#
# ONE model setting for every AI feature (page assistant, chat agent, tax
# classification, bookkeeping AI, statement extraction) — pick ANY provider with
# env only, no code change (lib/agent/llm.lua). Unset = Ollama via OLLAMA_* above.
# AI_PROVIDER=anthropic          # ollama | anthropic | openai (any OpenAI-compatible API)
# AI_MODEL=claude-opus-5-5       # else OLLAMA_MODEL / ANTHROPIC_MODEL / OPENAI_MODEL, then built-in defaults
# AI_API_KEY=sk-ant-...          # else OLLAMA_API_KEY / ANTHROPIC_API_KEY / OPENAI_API_KEY
# AI_BASE_URL=                   # optional: OpenRouter, Groq, vLLM, Azure-compatible gateway...
# AI_VISION_PROVIDER=            # optional: model that reads statement images/PDFs
# AI_VISION_MODEL=               # e.g. minicpm-v on Ollama; Claude/gpt-4.1 can read them directly
# AI_FALLBACK_PROVIDER=ollama    # used when the main provider fails: ollama (default) | anthropic | openai | none
# AI_FALLBACK_MODEL=             # default: that provider's own model (OLLAMA_MODEL on OLLAMA_URL / OLLAMA_API_KEY)
# AI_USER_DAILY_TOKEN_LIMIT=     # optional: tokens one user may use per UTC day, all AI features (unset = no limit)

# ============================================
# Google OAuth (Optional)
# ============================================
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://127.0.0.1:4020/auth/google/callback

# ============================================
# Keycloak SSO (Optional)
# ============================================
# KEYCLOAK_AUTH_URL=https://your-keycloak/realms/opsapi/protocol/openid-connect/auth
# KEYCLOAK_TOKEN_URL=https://your-keycloak/realms/opsapi/protocol/openid-connect/token
# KEYCLOAK_USERINFO_URL=https://your-keycloak/realms/opsapi/protocol/openid-connect/userinfo
# KEYCLOAK_CLIENT_ID=opsapi
# KEYCLOAK_CLIENT_SECRET=your-client-secret
KEYCLOAK_REDIRECT_URI=http://127.0.0.1:4020/auth/callback

# ============================================
# Stripe (Optional)
# ============================================
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================
# Billing & Entitlements (PROJECT_CODE=billing)
# ============================================
# EC P-256 private key (PEM, "\n" escapes ok) that signs entitlement tokens and
# offline licence files. Clients verify with GET /api/v2/public/billing/jwks.json.
# Generate: openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# BILLING_SIGNING_KEY=
# BILLING_SIGNING_KEY_ID=billing-2026-10
# Rotation: old public JWKs (JSON array) kept in the JWKS until old tokens expire.
# BILLING_PREVIOUS_PUBLIC_KEYS=[]
# Base URL of the hosted billing pages (the dashboard), used in access-link emails.
# BILLING_HOSTED_BASE_URL=https://billing.example.com
# Allow workspace SMTP servers on private addresses (dev / self-hosted only).
# OPSAPI_MAIL_ALLOW_PRIVATE=false

# ============================================
# HMRC Making Tax Digital (UK tax filing)
# ============================================
# HMRC_ENVIRONMENT switches base URLs + enables TLS verification:
#   sandbox    -> https://test-api.service.hmrc.gov.uk (ssl_verify off; test users + auto-provision)
#   production -> https://api.service.hmrc.gov.uk     (ssl_verify ON; real filings)
# HMRC_ENVIRONMENT=sandbox
# Credentials from your HMRC Developer Hub application (sandbox vs production are different apps):
# HMRC_CLIENT_ID=...
# HMRC_CLIENT_SECRET=...
# OAuth callback — must EXACTLY match the redirect URI registered on your HMRC application:
# HMRC_REDIRECT_URI=https://your-domain.example/auth/hmrc/callback
# The backend's PUBLIC egress IP (HMRC anti-fraud Gov-Vendor-Public-IP / Gov-Vendor-Forwarded).
# Required in production — HMRC rejects private IPs; omit for local dev. Find via `curl ifconfig.me`.
# HMRC_SERVER_PUBLIC_IP=203.0.113.10
